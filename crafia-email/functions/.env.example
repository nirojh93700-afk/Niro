# =============================================================================
# Configuration SMTP des Cloud Functions Crafia.
# Copiez ce fichier en "functions/.env" puis renseignez SMTP_PASS.
# Firebase Functions charge automatiquement functions/.env au déploiement.
# NE COMMITTEZ PAS le vrai fichier .env (il contient le mot de passe).
# =============================================================================

# URL de l'app (où l'utilisateur revient après l'action). Normalement inchangé.
APP_URL=https://app.crafia.fr

# Expéditeur affiché et adresse de réponse.
MAIL_FROM=Crafia <support@crafia.fr>
MAIL_REPLY_TO=support@crafia.fr


# -----------------------------------------------------------------------------
# OPTION A — SMTP OVH de support@crafia.fr  ← CHOISI (actif)
# Host pour les offres OVH "MX Plan" / email mutualisé : ssl0.ovh.net
# (Si vous êtes en "Email Pro", le host est plutôt pro1.mail.ovh.net / pro2 ;
#  en "Exchange", encore différent. À vérifier dans votre espace OVH > Emails.)
# -----------------------------------------------------------------------------
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@crafia.fr
SMTP_PASS=METTRE_ICI_LE_MOT_DE_PASSE_DE_LA_BOITE_support@crafia.fr


# -----------------------------------------------------------------------------
# OPTION B — Brevo (gratuit 300/j) — désactivé (gardé en secours)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=VOTRE_LOGIN_SMTP_BREVO
# SMTP_PASS=VOTRE_CLE_SMTP_BREVO


# -----------------------------------------------------------------------------
# OPTION C — Gmail (500/j) — désactivé
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votreadresse@gmail.com
# SMTP_PASS=MOT_DE_PASSE_DAPPLICATION_16_CARACTERES
