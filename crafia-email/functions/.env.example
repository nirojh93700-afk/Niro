# =============================================================================
# Configuration SMTP des Cloud Functions Crafia.
# Copiez ce fichier en "functions/.env" puis renseignez le bloc choisi.
# Firebase Functions charge automatiquement functions/.env au déploiement.
# NE COMMITTEZ PAS le vrai fichier .env (mots de passe).
# =============================================================================

# URL de l'app (où l'utilisateur revient après l'action). Normalement inchangé.
APP_URL=https://app.crafia.fr

# Expéditeur affiché. Doit être une adresse autorisée par votre SMTP.
MAIL_FROM=Crafia <support@crafia.fr>
MAIL_REPLY_TO=support@crafia.fr


# -----------------------------------------------------------------------------
# OPTION B — Brevo (ex-Sendinblue) — GRATUIT À VIE, 300 emails/jour.  ← PAR DÉFAUT
# Choix recommandé pour rester 100% gratuit.
#  1. Créez un compte sur brevo.com (gratuit).
#  2. Menu "SMTP & API" > onglet SMTP : créez une clé SMTP.
#  3. Recopiez le login et la clé ci-dessous.
#  4. Pour que les mails partent bien de support@crafia.fr sans finir en spam :
#     ajoutez les enregistrements DNS SPF + DKIM fournis par Brevo
#     (Brevo > Expéditeurs/Domaines > Authentifier crafia.fr).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=VOTRE_LOGIN_SMTP_BREVO
SMTP_PASS=VOTRE_CLE_SMTP_BREVO


# -----------------------------------------------------------------------------
# OPTION A — SMTP de support@crafia.fr (si un jour vous avez les identifiants).
# Le host dépend de votre hébergeur de mail. Exemples :
#   OVH   : ssl0.ovh.net     port 465 (SSL) ou 587
#   Gandi : mail.gandi.net   port 465
#   IONOS : smtp.ionos.fr    port 465
# -----------------------------------------------------------------------------
# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@crafia.fr
# SMTP_PASS=VOTRE_MOT_DE_PASSE_BOITE_MAIL


# -----------------------------------------------------------------------------
# OPTION C — Gmail (gratuit, 500/jour). Nécessite un "mot de passe d'application"
# (compte Google > Sécurité > Validation en 2 étapes > Mots de passe d'application).
# White-label moins bon (adresse @gmail visible si DKIM non aligné).
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votreadresse@gmail.com
# SMTP_PASS=MOT_DE_PASSE_DAPPLICATION_16_CARACTERES
