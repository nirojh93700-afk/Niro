# =============================================================================
# Configuration SMTP des Cloud Functions Crafia.
# Copiez ce fichier en "functions/.env" puis renseignez UN des 3 blocs ci-dessous.
# Firebase Functions charge automatiquement functions/.env au déploiement.
# NE COMMITTEZ PAS le vrai fichier .env (mots de passe).
# =============================================================================

# URL de l'app (où l'utilisateur revient après l'action). Normalement inchangé.
APP_URL=https://app.crafia.fr

# Expéditeur affiché. Doit être une adresse autorisée par votre SMTP.
MAIL_FROM=Crafia <support@crafia.fr>
MAIL_REPLY_TO=support@crafia.fr


# -----------------------------------------------------------------------------
# OPTION A — SMTP de support@crafia.fr (recommandé si vous avez les identifiants)
# Le host dépend de votre hébergeur de mail. Exemples courants :
#   OVH      : ssl0.ovh.net           port 465 (SSL)   ou 587 (STARTTLS)
#   Gandi    : mail.gandi.net         port 465
#   IONOS    : smtp.ionos.fr          port 465
# -----------------------------------------------------------------------------
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@crafia.fr
SMTP_PASS=VOTRE_MOT_DE_PASSE_BOITE_MAIL


# -----------------------------------------------------------------------------
# OPTION B — Brevo (ex-Sendinblue), 300 emails/jour gratuits
# Créez une clé SMTP dans Brevo > SMTP & API. Pensez à configurer SPF/DKIM
# sur crafia.fr (Brevo fournit les enregistrements DNS à ajouter).
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=VOTRE_LOGIN_SMTP_BREVO          # ex: 9a1b2c@smtp-brevo.com
# SMTP_PASS=VOTRE_CLE_SMTP_BREVO


# -----------------------------------------------------------------------------
# OPTION C — Gmail (500/jour, pour démarrer). Nécessite un "mot de passe
# d'application" (compte Google > Sécurité > Validation en 2 étapes > Mots de
# passe des applications). White-label moins bon (adresse @gmail visible).
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votreadresse@gmail.com
# SMTP_PASS=MOT_DE_PASSE_DAPPLICATION_16_CARACTERES
