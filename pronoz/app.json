{
  "expo": {
    "name": "Pronoz",
    "slug": "pronoz",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "pronoz",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0e1a",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0a0e1a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.pronoz.app",
      "userInterfaceStyle": "dark"
    },
    "android": {
      "package": "fr.pronoz.app",
      "userInterfaceStyle": "dark"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router", "expo-font"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
