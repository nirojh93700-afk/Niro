# =========================================================================
# Configuration Niv Création — copie ce fichier en « .env.local »
# puis remplis tes vraies valeurs (ne JAMAIS partager la clé secrète).
# =========================================================================

# --- Stripe (paiement par carte) -----------------------------------------
# Récupère ces clés sur https://dashboard.stripe.com/apikeys
# Pour tester : utilise les clés "test" (commencent par sk_test_ / pk_test_).
# Pour encaisser réellement : utilise les clés "live" (sk_live_ / pk_live_).
# (commence par sk_test_ en mode test, ou sk_live_ en réel)
STRIPE_SECRET_KEY=COLLE_TA_CLE_SECRETE_STRIPE_ICI
# (commence par pk_test_ en mode test, ou pk_live_ en réel)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=COLLE_TA_CLE_PUBLIQUE_STRIPE_ICI
# Secret de signature du webhook (commence par whsec_...) — voir DEPLOIEMENT.md.
# Permet l'envoi automatique d'un e-mail récap à chaque commande payée.
STRIPE_WEBHOOK_SECRET=COLLE_TON_SECRET_WEBHOOK_ICI

# --- Adresse publique du site ---------------------------------------------
# En local : http://localhost:3000
# En production : https://www.nivcreation.com (ton domaine, sans / à la fin)
NEXT_PUBLIC_SITE_URL=https://www.nivcreation.com

# --- Formulaire de contact (e-mail via Resend) ----------------------------
# Crée un compte gratuit sur https://resend.com puis génère une clé API.
# Sans ces variables, le formulaire affiche simplement ton e-mail direct.
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire :
CONTACT_EMAIL=contact.nivcreation@gmail.com
# Expéditeur : "onboarding@resend.dev" fonctionne pour tester ;
# en production, utilise une adresse de ton domaine vérifié dans Resend.
CONTACT_FROM=Niv Création <onboarding@resend.dev>
