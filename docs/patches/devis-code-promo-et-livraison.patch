diff --git a/src/lib/portDevis.js b/src/lib/portDevis.js
new file mode 100644
index 0000000..8631825
--- /dev/null
+++ b/src/lib/portDevis.js
@@ -0,0 +1,65 @@
+// LIVRAISON D'UN DEVIS — choisie par le client sur le lien du devis (03/10/2026, maquette validée
+// `docs/maquettes/devis-livraison-promo.html`). Même grille que le panier (`buildShippingOptions`),
+// calculée côté SERVEUR à partir du poids saisi sur chaque ligne du devis : le navigateur envoie
+// seulement « domicile / relais » + le point choisi, jamais un prix.
+//
+// Règles :
+//  · le choix n'existe que si CHAQUE ligne d'article porte un poids (g) et qu'aucune ligne « Livraison »
+//    n'a déjà été ajoutée à la main → les anciens devis restent exactement comme avant ;
+//  · colis (jamais lettre), France + Monaco ;
+//  · point relais seulement si l'option est activée dans Gestion → Livraison (Boxtal).
+import { buildShippingOptions } from "@/lib/shipping";
+import { estLignePort } from "@/lib/remiseDevis";
+
+export function poidsDevis(items) {
+  return (Array.isArray(items) ? items : [])
+    .filter((it) => !estLignePort(it?.desc))
+    .reduce((s, it) => s + (Number(it?.weight) || 0) * (Number(it?.qty) || 0), 0);
+}
+
+export function livraisonActive(items) {
+  const arts = (Array.isArray(items) ? items : []).filter((it) => it && !estLignePort(it.desc));
+  if (!arts.length) return false;
+  if (arts.length !== (Array.isArray(items) ? items : []).length) return false; // une ligne livraison existe déjà
+  return arts.every((it) => Number(it.weight) > 0);
+}
+
+// Nettoie le point relais reçu du navigateur (mêmes champs que /api/checkout).
+export function nettoyerRelais(rp) {
+  if (!rp || typeof rp !== "object") return null;
+  const carrier = String(rp.carrier || "").toUpperCase().slice(0, 8);
+  const carrierName = String(rp.carrierName || "").slice(0, 40);
+  const name = String(rp.name || "").slice(0, 80);
+  if (!name) return null;
+  return {
+    carrier, carrierName, name,
+    city: String(rp.city || "").slice(0, 40), street: String(rp.street || "").slice(0, 80), zipCode: String(rp.zipCode || "").slice(0, 10),
+  };
+}
+
+// Renvoie { ok, price, option, relaisOk, relaisFull, error } — `option` = entrée `shipping_options` Stripe.
+export function portDevis(q, settings, method = "domicile", rp = null) {
+  const relaisOk = Boolean(settings?.boxtal?.enabled);
+  if (!livraisonActive(q?.items)) return { ok: false, relaisOk, error: "Ce devis n'a pas de choix de livraison." };
+  const items = q.items;
+  const base = {
+    subtotal: q.total, letterOnly: false, totalGrams: poidsDevis(items),
+    parcelQty: items.reduce((s, it) => s + (Number(it.qty) || 0), 0), glassQty: 0,
+    config: settings?.shipping, boxtal: settings?.boxtal, country: "FR", express: false,
+  };
+  if (method === "relais") {
+    if (!relaisOk) return { ok: false, relaisOk, error: "Le point relais n'est pas disponible." };
+    const p = nettoyerRelais(rp);
+    const opts = buildShippingOptions({
+      ...base, deliveryMethod: "relais", relaisCarrier: p?.carrier || "",
+      relaisLabel: p ? [p.name.slice(0, 45), p.city.slice(0, 25)].filter(Boolean).join(", ") : "",
+    });
+    const sr = opts[0].shipping_rate_data;
+    return {
+      ok: true, relaisOk, price: sr.fixed_amount.amount / 100, option: opts[0],
+      relaisFull: p ? [p.carrierName, p.name, p.street, [p.zipCode, p.city].filter(Boolean).join(" ")].filter(Boolean).join(" — ").slice(0, 240) : "",
+    };
+  }
+  const opts = buildShippingOptions({ ...base, deliveryMethod: "domicile" });
+  return { ok: true, relaisOk, price: opts[0].shipping_rate_data.fixed_amount.amount / 100, option: opts[0], relaisFull: "" };
+}
diff --git a/src/lib/promoDevis.js b/src/lib/promoDevis.js
new file mode 100644
index 0000000..8ae536b
--- /dev/null
+++ b/src/lib/promoDevis.js
@@ -0,0 +1,34 @@
+// Vérification SERVEUR d'un code promo pour un devis (03/10/2026). Mêmes verrous que
+// /api/promo-validate (expiration, code nominatif lié à une adresse, usage unique par
+// e-mail) — le calcul de la remise est dans remiseDevis.js. Les codes « gravure offerte »
+// et « carte cadeau » dépendent d'un panier de la boutique : refusés ici, avec un message clair.
+import { getPromoCodes, hasUsedCode, ensureWelcomeCode, ensureReferralCode } from "@/lib/stock";
+import { calculRemiseDevis } from "@/lib/remiseDevis";
+
+export async function verifierCodeDevis(codeRaw, emailRaw, items) {
+  const code = String(codeRaw || "").trim().toUpperCase();
+  if (!code) return { valid: false };
+  let codes = await getPromoCodes();
+  let pc = codes[code];
+  if (!pc) {
+    const [bienvenue, parrainage] = await Promise.all([ensureWelcomeCode(), ensureReferralCode()]);
+    if (bienvenue === code || parrainage === code) { codes = await getPromoCodes(); pc = codes[code]; }
+  }
+  if (!pc) return { valid: false };
+  if (pc.expiresAt && Date.now() > pc.expiresAt) return { valid: false, expired: true };
+  const email = String(emailRaw || "").trim().toLowerCase();
+  const emailOk = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
+  if (pc.kind === "gravure" || pc.kind === "cadeau") return { valid: false, boutiqueSeulement: true };
+  if (pc.email) {
+    if (!emailOk) return { valid: false, needEmail: true };
+    if (email !== pc.email) return { valid: false, wrongEmail: true };
+  }
+  if (!pc.reusable) {
+    if (!emailOk) return { valid: false, needEmail: true };
+    if (await hasUsedCode(code, { email })) return { valid: false, used: true };
+  }
+  const remise = calculRemiseDevis(pc, items);
+  if (!(remise > 0)) return { valid: false };
+  const label = pc.type === "fixed" ? `−${pc.value} €` : `−${pc.value} %`;
+  return { valid: true, code, remise, label, email: emailOk ? email : "" };
+}
diff --git a/src/lib/remiseDevis.js b/src/lib/remiseDevis.js
new file mode 100644
index 0000000..e2a3425
--- /dev/null
+++ b/src/lib/remiseDevis.js
@@ -0,0 +1,26 @@
+// Remise d'un code promo sur un DEVIS (03/10/2026) — calcul pur, sans accès base.
+// Demande du gérant : le client s'inscrit, reçoit son code (ex. BIENVENUE10) puis le saisit
+// sur le lien du devis. La remise porte sur les lignes d'articles, JAMAIS sur la livraison
+// (même règle qu'au panier, où le coupon ne touche pas au port).
+
+const LIGNE_PORT = /^\s*(livraison|port\b|frais de (port|livraison)|expédition|expedition)/i;
+
+export function estLignePort(desc) {
+  return LIGNE_PORT.test(String(desc || ""));
+}
+
+export function totalRemisable(items) {
+  const t = (Array.isArray(items) ? items : [])
+    .filter((it) => !estLignePort(it?.desc))
+    .reduce((s, it) => s + (Number(it?.qty) || 0) * (Number(it?.price) || 0), 0);
+  return Math.round(t * 100) / 100;
+}
+
+// pc = { type: "percent" | "fixed", value }. Renvoie le montant déduit en euros (0 = rien).
+export function calculRemiseDevis(pc, items) {
+  const base = totalRemisable(items);
+  const v = Number(pc?.value) || 0;
+  if (!(base > 0) || !(v > 0)) return 0;
+  const brut = pc.type === "fixed" ? v : (base * Math.min(100, v)) / 100;
+  return Math.round(Math.min(brut, base) * 100) / 100;
+}
diff --git a/tools/tests/port-devis.mjs b/tools/tests/port-devis.mjs
new file mode 100644
index 0000000..052a4bc
--- /dev/null
+++ b/tools/tests/port-devis.mjs
@@ -0,0 +1,29 @@
+// Livraison choisie par le client sur un devis (03/10/2026) : `npm run test-port-devis`
+import { poidsDevis, livraisonActive, portDevis, nettoyerRelais } from "../../src/lib/portDevis.js";
+let ok = 0, ko = 0;
+const t = (nom, cond, extra = "") => { if (cond) ok++; else { ko++; console.log("✗", nom, extra); } };
+const cle = { desc: "Clé USB 64 Go gravée", qty: 1, price: 44.9, weight: 150 };
+const q = { items: [cle], total: 44.9 };
+const settings = { boxtal: { enabled: true }, shipping: undefined };
+t("poids d'une ligne", poidsDevis([cle]) === 150);
+t("poids × quantité", poidsDevis([{ ...cle, qty: 3 }]) === 450);
+t("la ligne livraison n'ajoute pas de poids", poidsDevis([cle, { desc: "Livraison", qty: 1, price: 6.9, weight: 999 }]) === 150);
+t("choix actif quand chaque ligne a un poids", livraisonActive([cle]));
+t("pas de choix si un poids manque", !livraisonActive([cle, { desc: "Boîte", qty: 1, price: 5 }]));
+t("pas de choix si une ligne livraison existe déjà", !livraisonActive([cle, { desc: "Livraison", qty: 1, price: 6.9 }]));
+t("pas de choix sur un ancien devis (aucun poids)", !livraisonActive([{ desc: "Carafe", qty: 1, price: 54.9 }]));
+t("devis vide", !livraisonActive([]));
+const dom = portDevis(q, settings, "domicile");
+t("domicile 1 clé coffret = 6,90 €", dom.ok && dom.price === 6.9, JSON.stringify(dom.price));
+const rp = { carrier: "MONR", carrierName: "Mondial Relay", name: "Tabac Le Balto", street: "12 rue de la Gare", zipCode: "95350", city: "Saint-Brice" };
+const rel = portDevis(q, settings, "relais", rp);
+t("relais Mondial Relay = 4,90 €", rel.ok && rel.price === 4.9, JSON.stringify(rel.price));
+t("adresse du point relais complète pour la commande", rel.relaisFull === "Mondial Relay — Tabac Le Balto — 12 rue de la Gare — 95350 Saint-Brice", rel.relaisFull);
+t("relais sans point choisi = pas d'adresse", portDevis(q, settings, "relais", null).relaisFull === "");
+t("relais refusé si l'option est coupée dans Gestion", !portDevis(q, { boxtal: { enabled: false } }, "relais", rp).ok);
+t("devis sans poids = pas de livraison calculée", !portDevis({ items: [{ desc: "x", qty: 1, price: 5 }], total: 5 }, settings, "domicile").ok);
+t("le prix vient du poids : colis lourd plus cher", portDevis({ items: [{ ...cle, weight: 4000 }], total: 44.9 }, settings, "domicile").price > 6.9);
+t("le point relais est nettoyé", nettoyerRelais({ ...rp, name: "x".repeat(200) }).name.length === 80 && nettoyerRelais({ carrier: "MONR" }) === null);
+t("l'option Stripe est un tarif fixe en centimes", dom.option.shipping_rate_data.fixed_amount.amount === 690 && dom.option.shipping_rate_data.fixed_amount.currency === "eur");
+console.log(ko ? `${ko} échec(s)` : `OK — ${ok} vérifications`);
+process.exit(ko ? 1 : 0);
diff --git a/tools/tests/remise-devis.test.mjs b/tools/tests/remise-devis.test.mjs
