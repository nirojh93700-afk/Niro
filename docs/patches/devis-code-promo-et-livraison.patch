diff --git a/src/app/api/quote-promo/route.js b/src/app/api/quote-promo/route.js
new file mode 100644
index 0000000..e8d79b5
--- /dev/null
+++ b/src/app/api/quote-promo/route.js
@@ -0,0 +1,18 @@
+import { getQuote } from "@/lib/firebase";
+import { verifierCodeDevis } from "@/lib/promoDevis";
+
+export const dynamic = "force-dynamic";
+
+// Vérifie un code promo sur un devis (public, comme /api/promo-validate) et renvoie la
+// remise réelle + le nouveau total. Rien n'est enregistré ici : le code n'est consommé
+// qu'au paiement (webhook Stripe).
+export async function POST(req) {
+  let body;
+  try { body = await req.json(); } catch { return Response.json({ valid: false }); }
+  const q = body?.id ? await getQuote(body.id) : null;
+  if (!q || q.type === "facture" || q.status === "paye") return Response.json({ valid: false });
+  const email = String(body?.email || q.client?.email || "");
+  const r = await verifierCodeDevis(body?.code, email, q.items);
+  if (!r.valid) return Response.json(r);
+  return Response.json({ ...r, total: Math.round((q.total - r.remise) * 100) / 100 });
+}
diff --git a/src/app/api/quote-shipping/route.js b/src/app/api/quote-shipping/route.js
new file mode 100644
index 0000000..6ecb69f
--- /dev/null
+++ b/src/app/api/quote-shipping/route.js
@@ -0,0 +1,25 @@
+import { getQuote } from "@/lib/firebase";
+import { getSettings } from "@/lib/stock";
+import { livraisonActive, poidsDevis, portDevis } from "@/lib/portDevis";
+
+export const dynamic = "force-dynamic";
+
+// Prix de livraison d'un devis (public, comme le panier). Sans « method » : état de départ
+// { actif, poids, domicile, relaisDes, relaisOk }. Avec method + point relais : prix exact.
+export async function POST(req) {
+  let body;
+  try { body = await req.json(); } catch { return Response.json({ actif: false }); }
+  const q = body?.id ? await getQuote(body.id) : null;
+  if (!q || q.type === "facture" || q.status === "paye" || !livraisonActive(q.items)) return Response.json({ actif: false });
+  const settings = await getSettings();
+  if (body?.method === "relais" || body?.method === "domicile") {
+    const r = portDevis(q, settings, body.method, body.relaisPoint);
+    return Response.json(r.ok ? { actif: true, price: r.price } : { actif: true, error: r.error });
+  }
+  const dom = portDevis(q, settings, "domicile");
+  const rel = portDevis(q, settings, "relais");
+  return Response.json({
+    actif: true, poids: poidsDevis(q.items), domicile: dom.price,
+    relaisOk: rel.ok, relaisDes: rel.ok ? rel.price : null,
+  });
+}
